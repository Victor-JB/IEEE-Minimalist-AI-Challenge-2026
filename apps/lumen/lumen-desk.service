# systemd *user* service: the Lumen Desk web page (http://luxo3:8081/) at boot on the luxoIII board.
# Install: cp lumen-desk.service ~/.config/systemd/user/ && systemctl --user enable --now lumen-desk
# The desk and Lumen both need the arm and the camera, so starting one stops the other.
[Unit]
Description=Lumen Desk web page (arm, camera, light)
After=default.target
Conflicts=lumen.service

[Service]
WorkingDirectory=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/lumen
# Wait for the Arduino router (it owns the MCU serial link) before starting.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -S /var/run/arduino-router.sock ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/lumen/.venv/bin/python -u -m lumen.desk --port 8081
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
