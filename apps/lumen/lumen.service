# systemd *user* service: starts Lumen at boot on the Arduino Q.
# Installed by scripts/deploy.sh to ~/.config/systemd/user/lumen.service.
# Boot without a login works because linger is enabled for `arduino` (Tailscale uses the same).
[Unit]
Description=Lumen expressive lamp behavior
After=default.target

[Service]
WorkingDirectory=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/lumen
# Wait for the Arduino router (it owns the MCU serial link) before starting.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -S /var/run/arduino-router.sock ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/lumen/.venv/bin/python -m lumen --headless --stream 8080
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
