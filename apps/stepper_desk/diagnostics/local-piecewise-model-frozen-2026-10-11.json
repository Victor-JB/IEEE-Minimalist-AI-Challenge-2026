  "model_definition": "N = abs(F(final)-F(initial)) + reversal_pulses*reversal; F(q)=(q-knot)*gain_below_or_above_knot",
  "fit_policy": "All eight pre-heldout trials per joint, least squares on pulse counts, nonnegative reversal offset; knots fixed at previously observed region boundaries, not optimized",
  "validation_plan": {
    "endpoint_tolerance_deg": 0.5,
    "desired_travel_deg": 6,
    "required_conditions": [
      "Every heldout passes existing telemetry/settling guards",
      "Both directions and known reversal/continuation history",
      "Sample both sides and cross the knot",
      "Never extrapolate outside training envelope",
      "No parameter adjustment after seeing heldouts"
    ],
    "historical_failure_policy": "Any pre-existing training error above tolerance remains disclosed; passing new trials does not erase it"
  },
  "limitations": [
    "Reported encoder coordinates only; mounting confirmation is not independent physical angle validation.",
    "Local endpoint prediction only, not coordinated trajectory/path accuracy.",
    "Shoulder retains an earlier lower-region training mismatch above0.5degree; a constant-gain or globallyverified calibration is not justified."
  ]
}
