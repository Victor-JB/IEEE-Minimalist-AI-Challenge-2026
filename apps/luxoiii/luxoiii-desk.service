# systemd *user* service: the luxoiii Desk web page (http://luxo3:8081/) at boot on the luxoiii board.
# Install: cp luxoiii-desk.service ~/.config/systemd/user/ && systemctl --user enable --now luxoiii-desk
# Supplies camera frames to the main observer. Manual arm controls remain a separate tool.
[Unit]
Description=luxoiii Desk web page (arm, camera, light)
Conflicts=lumen.service lumen-desk.service

[Service]
WorkingDirectory=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/luxoiii
# Wait for the Arduino router (it owns the MCU serial link) before starting.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -S /var/run/arduino-router.sock ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/luxoiii/.venv/bin/python -u -m luxoiii.desk --port 8081
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
