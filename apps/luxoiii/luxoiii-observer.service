# Board perception + working head swivel + gated digital D7 on/off. No stepper commands.
[Unit]
Description=luxoiii camera AI and physical outputs
PartOf=luxoiii.service
Conflicts=lumen.service lumen-desk.service luxoiii-desk.service

[Service]
WorkingDirectory=/home/arduino/IEEE-Minimalist-AI-Challenge-2026
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -S /var/run/arduino-router.sock ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/arduino/IEEE-Minimalist-AI-Challenge-2026/apps/luxoiii/.venv/bin/python -u tools/spatial/observe.py --repo /home/arduino/IEEE-Minimalist-AI-Challenge-2026 --hybrid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
